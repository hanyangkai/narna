UAP_DATABASE_URL=postgresql+psycopg2://uap:uap@localhost:5432/uap_cloud
UAP_REDIS_URL=redis://localhost:6379/0

# Card/Stripe/Paddle removed — mock only flips plan locally for demos
UAP_BILLING_MODE=mock
UAP_RATE_LIMIT_PER_MIN=120
UAP_CLOUD_CORS_ORIGIN=*
UAP_LOG_LEVEL=INFO

NARNA_PUBLIC_URL=https://narna.org
UAP_SITE_URL=https://narna.org

# Transactional email (signup key, recovery link, payment receipt)
# UAP_SMTP_HOST=smtp.example.com
# UAP_SMTP_PORT=587
# UAP_SMTP_USER=
# UAP_SMTP_PASSWORD=
# UAP_SMTP_FROM=noreply@narna.org
# UAP_SMTP_STARTTLS=1
# UAP_SMTP_SSL=0

# ── Crypto billing (USDC / USDT) ──
# mock = auto-confirm for local demos; live = on-chain bot
UAP_CRYPTO_MODE=live
UAP_CRYPTO_RECEIVER_WALLET=0x24DAb37fd89222710ce1D5A4c4E81e26D51E34D5
UAP_CRYPTO_BOT_ENABLED=1
UAP_ETH_RPC_URL=https://ethereum.publicnode.com
UAP_POLYGON_RPC_URL=https://polygon-bor.publicnode.com
UAP_BASE_RPC_URL=https://mainnet.base.org
UAP_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
UAP_BSC_RPC_URL=https://bsc-dataseed.binance.org

# Ask NARNA / Model Router (NGS-0028)
# mock | openrouter | openai | ollama
UAP_ROUTER_PROVIDER=mock
# UAP_OPENROUTER_API_KEY=
# UAP_OPENAI_API_KEY=
# UAP_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# UAP_ROUTER_MODEL_CHEAP=openai/gpt-4o-mini
# UAP_ROUTER_MODEL_REASON=openai/gpt-4o-mini
# UAP_ROUTER_MODEL_CHALLENGE=openai/gpt-4o-mini

# Phone channel — Telegram Ask NARNA
# Create bot via @BotFather, then set webhook:
#   https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://api.narna.org/v1/agent/telegram/webhook&secret_token=<SECRET>
# UAP_TELEGRAM_BOT_TOKEN=
# UAP_TELEGRAM_WEBHOOK_SECRET=
# Discord Ask channel
# UAP_DISCORD_BOT_TOKEN=
# UAP_DISCORD_WEBHOOK_SECRET=
# Slack Events API
# UAP_SLACK_BOT_TOKEN=
# WhatsApp via Twilio
# UAP_TWILIO_ACCOUNT_SID=
# UAP_TWILIO_AUTH_TOKEN=
# UAP_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Signal bridge outbound URL
# UAP_SIGNAL_WEBHOOK_URL=https://signal-bridge.example/send
# Shell backend: local | docker
# UAP_SHELL_BACKEND=local
# UAP_SHELL_DOCKER_IMAGE=python:3.12-alpine
# Background cron for agent jobs (default on)
# UAP_AGENT_JOBS_TICKER=1
# UAP_AGENT_JOBS_TICK_SEC=300
# UAP_JOBS_TICK_SECRET=

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
