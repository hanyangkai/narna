# Optional Agent Container image — policy contract + deny-by-default network at runtime.
# Build: docker build -f web/deploy/selfhost/Dockerfile.agent-container -t narna/agent-container:0.1 .
# Run via: narna container docker-run --dry-run
FROM python:3.12-slim
WORKDIR /workspace
RUN pip install --no-cache-dir PyYAML
# Minimal runtime — host mounts workspace; network disabled by runner default
CMD ["python", "-c", "print('narna agent container ready')"]
