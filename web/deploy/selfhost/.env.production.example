# https://api.narna.org/v1/agent/facebook/webhook
# https://api.narna.org/v1/agent/instagram/webhook
# https://api.narna.org/v1/agent/youtube/webhook

# Frontend build args
# VITE_API_URL=https://api.narna.org

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
