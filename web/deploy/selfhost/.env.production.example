# Production env for VPS — narna.org
# Copy to /opt/narna/web/deploy/selfhost/.env

UAP_DATABASE_URL=postgresql+psycopg2://uap:CHANGE_ME@postgres:5432/uap_cloud
UAP_REDIS_URL=redis://redis:6379/0
# Card/Stripe/Paddle retired — keep mock for local plan flips; live crypto via UAP_CRYPTO_MODE
UAP_BILLING_MODE=mock
UAP_CRYPTO_MODE=live
UAP_CRYPTO_RECEIVER_WALLET=0x24DAb37fd89222710ce1D5A4c4E81e26D51E34D5
UAP_CRYPTO_BOT_ENABLED=1
UAP_RATE_LIMIT_PER_MIN=120
UAP_ADQA_REQUIRE_AUTH=1
UAP_TENANT_ROOT=/data/tenants
NARNA_PUBLIC_URL=https://narna.org
UAP_CLOUD_CORS_ORIGIN=https://narna.org
UAP_LOG_LEVEL=INFO

# Per-chain RPC (public defaults; swap for Alchemy/Infura if rate-limited)
UAP_ETH_RPC_URL=https://ethereum.publicnode.com
UAP_POLYGON_RPC_URL=https://polygon-bor.publicnode.com
UAP_BASE_RPC_URL=https://mainnet.base.org
UAP_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
UAP_BSC_RPC_URL=https://bsc-dataseed.binance.org

# Ask NARNA Model Router — use mock until OpenRouter key set
UAP_ROUTER_PROVIDER=mock
# UAP_OPENROUTER_API_KEY=
# UAP_ROUTER_MODEL_REASON=openai/gpt-4o-mini

# Frontend build args
# VITE_API_URL=https://api.narna.org

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
