# Copy to .dev.vars for local wrangler dev. Never commit .dev.vars or keys.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.8-flash-lite,gemini-3.6-flash,gemma-4-31b-it,gemma-4-26b-it
# GROQ_API_KEY=          # optional; Groq is skipped when unset
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
CF_GPT_OSS_MODELS=@cf/openai/gpt-oss-120b,@cf/openai/gpt-oss-20b
# OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,openrouter/free
# ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODELS=glm-4.7-flash
CF_MODELS=@cf/meta/llama-3.1-8b-instruct-fp8-fast,@cf/google/gemma-4-26b-a4b-it,@cf/qwen/qwen3.8-27b
ENABLED_PROVIDERS=groq,google,workersai,openrouter,zai
DAILY_LIMIT=10
DEV_ALLOW_UNATTESTED=1
