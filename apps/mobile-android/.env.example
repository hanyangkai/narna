# NARNA Android - Environment Variables
# Copy this file to .env and fill in your values

# ===========================
# Android Signing (Required for release builds)
# ===========================

# Path to release keystore file
ANDROID_KEYSTORE_PATH=./narna-release.keystore

# Keystore password
ANDROID_KEYSTORE_PASSWORD=narnarelease2024

# Key alias
ANDROID_KEY_ALIAS=narna

# Key password
ANDROID_KEY_PASSWORD=narnarelease2024

# ===========================
# Google Play Upload (Optional - for fastlane automation)
# ===========================

# Path to Google Play service account JSON key
# Get this from Google Play Console → Setup → API access
GOOGLE_PLAY_JSON_KEY_PATH=/path/to/service-account.json

# ===========================
# Development (Optional)
# ===========================

# Android SDK location (if not in default location)
# ANDROID_HOME=/path/to/android-sdk

# Enable debug logging
# DEBUG=true
