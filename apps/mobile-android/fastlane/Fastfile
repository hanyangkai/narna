# Fastlane configuration for NARNA Android app
# Auto-submission to Google Play

default_platform(:android)

platform :android do
  desc "Build and upload to Google Play"
  lane :release do
    # Increment version code
    gradle(
      task: "clean"
    )
    
    # Build AAB (Android App Bundle)
    gradle(
      task: "bundle",
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => ENV["ANDROID_KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"]
      }
    )
    
    # Upload to Google Play (Production track)
    upload_to_play_store(
      track: "production",
      release_status: "completed",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      json_key: ENV["GOOGLE_PLAY_JSON_KEY_PATH"],
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
    
    # Send notification
    notification(
      title: "NARNA Android",
      message: "Successfully uploaded to Google Play! 🎉"
    )
  end
  
  desc "Build and upload to Internal Testing"
  lane :beta do
    gradle(
      task: "bundle",
      build_type: "Release"
    )
    
    upload_to_play_store(
      track: "internal",
      release_status: "completed",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      json_key: ENV["GOOGLE_PLAY_JSON_KEY_PATH"],
      skip_upload_apk: true
    )
    
    notification(
      title: "NARNA Android Beta",
      message: "Internal testing build uploaded! 🚀"
    )
  end
  
  desc "Generate screenshots"
  lane :screenshots do
    screengrab(
      locales: ["en-US", "vi-VN"],
      clear_previous_screenshots: true,
      app_package_name: "org.narna.mobile",
      use_tests_in_packages: ["org.narna.mobile.screenshots"],
      tests_apk_path: "app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk",
      app_apk_path: "app/build/outputs/apk/debug/app-debug.apk"
    )
  end
  
  desc "Setup signing keystore"
  lane :setup_signing do
    # Generate new keystore if doesn't exist
    sh("keytool -genkey -v -keystore narna-release.keystore -alias narna -keyalg RSA -keysize 2048 -validity 10000") unless File.exist?("narna-release.keystore")
  end
end
