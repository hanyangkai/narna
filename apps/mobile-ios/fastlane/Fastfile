# Fastlane configuration for NARNA iOS app
#
# Required env (see .env.example):
#   APPLE_TEAM_ID, FASTLANE_API_KEY_ID, FASTLANE_API_KEY_ISSUER_ID, FASTLANE_API_KEY_PATH
# Optional:
#   SUBMIT_FOR_REVIEW=true   submit the uploaded build for App Review (default: false)

default_platform(:ios)

PROJECT = "NARNA/NARNA.xcodeproj"
APP_ID  = "org.narna.mobile"

platform :ios do
  private_lane :asc_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("FASTLANE_API_KEY_ID"),
      issuer_id: ENV.fetch("FASTLANE_API_KEY_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("FASTLANE_API_KEY_PATH")),
      in_house: false
    )
  end

  private_lane :build_ipa do
    key_path = File.expand_path(ENV.fetch("FASTLANE_API_KEY_PATH"))
    team = ENV.fetch("APPLE_TEAM_ID")

    # BUILD_NUMBER env overrides the lookup (latest_testflight_build_number can fail
    # with "required agreement missing" and silently fall back to 0).
    build_no = ENV["BUILD_NUMBER"]
    unless build_no
      latest = begin
        latest_testflight_build_number(app_identifier: APP_ID)
      rescue StandardError
        0
      end
      build_no = (latest.to_i + 1).to_s
      increment_build_number(xcodeproj: PROJECT, build_number: build_no)
    end

    gym(
      project: PROJECT,
      scheme: "NARNA",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "NARNA.ipa",
      clean: true,
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{key_path}",
        "-authenticationKeyID #{ENV.fetch('FASTLANE_API_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('FASTLANE_API_KEY_ISSUER_ID')}",
        "DEVELOPMENT_TEAM=#{team}",
        "CURRENT_PROJECT_VERSION=#{build_no}",
        "CODE_SIGN_STYLE=Automatic"
      ].join(" "),
      export_options: {
        teamID: team,
        signingStyle: "automatic"
      }
    )
  end

  desc "Build and upload to App Store Connect (optionally submit for review)"
  lane :release do
    asc_key
    build_ipa

    submit = ENV["SUBMIT_FOR_REVIEW"] == "true"
    has_screens = Dir.glob("./fastlane/screenshots/**/*.{png,jpg,jpeg}").any?

    deliver(
      app_identifier: APP_ID,
      ipa: "./build/NARNA.ipa",
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      skip_screenshots: !has_screens,
      overwrite_screenshots: has_screens,
      submit_for_review: submit,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false
      }
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    asc_key
    build_ipa
    upload_to_testflight(
      ipa: "./build/NARNA.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
