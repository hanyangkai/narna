# Fastlane configuration for NARNA iOS app
# Auto-submission to App Store

default_platform(:ios)

platform :ios do
  desc "Build and upload to App Store"
  lane :release do
    # Increment build number
    increment_build_number(xcodeproj: "NARNA.xcodeproj")
    
    # Build IPA
    gym(
      scheme: "NARNA",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "NARNA.ipa",
      clean: true,
      export_options: {
        provisioningProfiles: {
          "org.narna.mobile" => "match AppStore org.narna.mobile"
        }
      }
    )
    
    # Upload to App Store Connect
    deliver(
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      skip_binary_upload: false,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false
      }
    )
    
    # Send notification
    notification(
      title: "NARNA iOS",
      message: "Successfully uploaded to App Store! 🎉"
    )
  end
  
  desc "Build and upload to TestFlight"
  lane :beta do
    increment_build_number(xcodeproj: "NARNA.xcodeproj")
    
    gym(
      scheme: "NARNA",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "NARNA.ipa"
    )
    
    pilot(
      skip_submission: false,
      skip_waiting_for_build_processing: false,
      distribute_external: true,
      notify_external_testers: true,
      changelog: "New build for testing"
    )
    
    notification(
      title: "NARNA iOS Beta",
      message: "TestFlight build uploaded! ✈️"
    )
  end
  
  desc "Generate screenshots"
  lane :screenshots do
    snapshot(
      scheme: "NARNA",
      devices: [
        "iPhone 15 Pro Max",
        "iPhone 15",
        "iPad Pro (12.9-inch) (6th generation)"
      ],
      languages: ["en-US", "vi"],
      clear_previous_screenshots: true,
      override_status_bar: true,
      number_of_retries: 3
    )
  end
  
  desc "Setup code signing"
  lane :setup_signing do
    match(
      type: "appstore",
      app_identifier: "org.narna.mobile",
      readonly: false
    )
  end
end
