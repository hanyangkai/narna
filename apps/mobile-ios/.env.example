# NARNA iOS App Store Environment Variables
# Copy this file to .env and fill in your credentials
# DO NOT commit the .env file to version control!

# Apple Developer Account
APPLE_ID=your-apple-id@email.com
APPLE_TEAM_ID=YOUR_TEAM_ID

# App Store Connect API Key (Recommended)
FASTLANE_API_KEY_ID=YOUR_KEY_ID
FASTLANE_API_KEY_ISSUER_ID=YOUR_ISSUER_ID
FASTLANE_API_KEY_PATH=~/AuthKey_XXXXXXXX.p8

# Alternative: App-Specific Password (Less secure)
# FASTLANE_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional: Match (code signing)
MATCH_GIT_URL=https://github.com/yourorg/certificates
MATCH_PASSWORD=your-match-encryption-password

# Optional: Slack notifications
# SLACK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
